POSTGRES_DB=barberflow
POSTGRES_USER=barberflow
POSTGRES_PASSWORD=change-this-for-shared-environments
POSTGRES_PORT=5432
API_PORT=8080
APP_PORT=8081

# Production-only values. Use generated secrets and never commit the real file.
BARBERFLOW_PUBLIC_BASE_URL=https://example.com
BARBERFLOW_ALLOWED_ORIGINS=https://example.com
BARBERFLOW_TIME_ZONE=Europe/Lisbon
BARBERFLOW_MAIL_HOST=smtp.example.com
BARBERFLOW_MAIL_PORT=587
BARBERFLOW_MAIL_USERNAME=replace-me
BARBERFLOW_MAIL_PASSWORD=replace-me
BARBERFLOW_MAIL_FROM="BarberFlow <no-reply@example.com>"
# Use these server-side values instead of SMTP for provider-scheduled reminders.
# BARBERFLOW_MAIL_DELIVERY=resend
# RESEND_API_KEY=replace-with-server-side-api-key
BARBERFLOW_CANCELLATION_MIN_HOURS=2
BARBERFLOW_RETENTION_DAYS=365

# Vercel + Supabase deployment values. Keep real credentials in Vercel only.
# BARBERFLOW_DATABASE_URL=jdbc:postgresql://pooler-host:5432/postgres?sslmode=require
# BARBERFLOW_DATABASE_USERNAME=postgres.project-ref
# BARBERFLOW_DATABASE_PASSWORD=replace-with-supabase-database-password
# BARBERFLOW_DATABASE_MAX_POOL_SIZE=2
# CRON_SECRET=generate-with-openssl-rand-hex-32
