POSTGRES_DB=barberflow
POSTGRES_USER=barberflow
POSTGRES_PASSWORD=change-this-for-shared-environments
POSTGRES_PORT=5432
API_PORT=8080
APP_PORT=8081

# Production-only values. Use generated secrets and never commit the real file.
BARBERFLOW_PUBLIC_BASE_URL=https://example.com
BARBERFLOW_ALLOWED_ORIGINS=https://example.com
BARBERFLOW_TIME_ZONE=Europe/Lisbon
BARBERFLOW_MAIL_HOST=smtp.example.com
BARBERFLOW_MAIL_PORT=587
BARBERFLOW_MAIL_USERNAME=replace-me
BARBERFLOW_MAIL_PASSWORD=replace-me
BARBERFLOW_MAIL_FROM="BarberFlow <no-reply@example.com>"
BARBERFLOW_CANCELLATION_MIN_HOURS=2
BARBERFLOW_RETENTION_DAYS=365
