{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "ng test --watch=false",
    "test:e2e": "playwright test",
    "test:e2e:types": "tsc --project e2e/tsconfig.json",
    "test:all": "pnpm test:unit && pnpm test:e2e:types && pnpm test:e2e",
    "test:unit:report": "ng test --watch=false --reporters=junit --output-file=test-results/unit.xml"
  },
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@lucide/angular": "1.69.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
